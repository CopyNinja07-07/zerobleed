# Copy to .env and fill in. .env is gitignored; never commit real values.
# Not needed for SAMPLE_MODE=true (offline replay).

# Meterless Nightshift Runtime (Console > Runtime). The NVIDIA key goes in Nightshift's Providers tab, not here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=paste-your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Zetaris REST API (Management > API Tokens)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=paste-your-zetaris-api-key

# Optional
# SAMPLE_MODE=true
# PORT=8000
# DASHBOARD_PORT=3030
